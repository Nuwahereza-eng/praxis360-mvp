# --- Praxis360 environment ---

# SQLite on the Railway persistent volume (mount volume at /data).
# For local dev use: file:./dev.db
DATABASE_URL="file:/data/dev.db"

# JWT session signing secret. REQUIRED. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# Optional AI provider. Leave blank for deterministic demo fallback.
AI_PROVIDER=""
AI_API_KEY=""

# Port is provided by Railway automatically; no need to set.
