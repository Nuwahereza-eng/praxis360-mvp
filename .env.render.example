# --- Praxis360 environment ---

# SQLite on the Render (relative path is fine; ephemeral on free plan).
# For local dev use: file:./dev.db
DATABASE_URL="file:./prisma/dev.db"

# JWT session signing secret. REQUIRED. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# Optional AI provider. Leave blank for deterministic demo fallback.
AI_PROVIDER=""
AI_API_KEY=""

# Port is provided by Render automatically; no need to set.
